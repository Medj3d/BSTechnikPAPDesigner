          <ENTRIES>
            <ENTRY COLUMN="0" ROW="0" ANCHOR="True" bst:GENERATED="True">
              <FIGURE SUBTYPE="PapTitle" FORMAT="1.00" ID="0">
                <TEXT><![CDATA[Lernbeispiel 1 – Ablaufplan]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="1" ROW="1" bst:X="0" bst:Y="0" bst:WIDTH="120" bst:HEIGHT="40">
              <FIGURE SUBTYPE="PapStart" FORMAT="1.00" ID="1" bst:UID="23a6808ac9fe49d8aaeb1a9505101e37">
                <TEXT><![CDATA[Start]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="1" ROW="2" bst:X="0" bst:Y="100" bst:WIDTH="160" bst:HEIGHT="60">
              <FIGURE SUBTYPE="PapInput" FORMAT="1.00" ID="2" bst:UID="bd428361a5f941e0a7ac2f3589364c71">
                <TEXT><![CDATA[Radius r einlesen]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="1" ROW="4" bst:X="0" bst:Y="200" bst:WIDTH="160" bst:HEIGHT="60">
              <FIGURE SUBTYPE="PapActivity" FORMAT="1.00" ID="3" bst:UID="d8942531f87d49c585fa97f9a33f9b20">
                <TEXT><![CDATA[fläche = runden(pi * r ^ 2, 2)]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="1" ROW="5" bst:X="0" bst:Y="300" bst:WIDTH="160" bst:HEIGHT="60">
              <FIGURE SUBTYPE="PapOutput" FORMAT="1.00" ID="4" bst:UID="17e07d1168604ab3b789ddd240904799">
                <TEXT><![CDATA[„Fläche:“ fläche]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="1" ROW="6" bst:X="0" bst:Y="400" bst:WIDTH="120" bst:HEIGHT="40">
              <FIGURE SUBTYPE="PapEnd" FORMAT="1.00" ID="5" bst:UID="51e65c2dc0604740ad74b3c0bef8687c">
                <TEXT><![CDATA[Ende]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="0" ROW="1" bst:X="-364" bst:Y="0" bst:WIDTH="300" bst:HEIGHT="60">
              <FIGURE SUBTYPE="PapComment" FORMAT="1.00" ID="6" bst:UID="96d8a91191fc4d3db786f2a286bd4000">
                <TEXT><![CDATA[Jeder Ablauf beginnt mit Start
und endet mit Ende.]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="0" ROW="2" bst:X="-364" bst:Y="100" bst:WIDTH="300" bst:HEIGHT="60">
              <FIGURE SUBTYPE="PapComment" FORMAT="1.00" ID="7" bst:UID="2b1718c256c24f24b65379ea3cf64f8b">
                <TEXT><![CDATA[Eingabe (Parallelogramm):
Der Wert landet in der Variablen r.]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="0" ROW="4" bst:X="-364" bst:Y="200" bst:WIDTH="300" bst:HEIGHT="80">
              <FIGURE SUBTYPE="PapComment" FORMAT="1.00" ID="8" bst:UID="2d95a5b898f448b388e33932afcb6f13">
                <TEXT><![CDATA[Verarbeitung (Rechteck): links die
Variable, rechts die Rechnung –
hier auf 2 Stellen gerundet.]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="0" ROW="5" bst:X="-364" bst:Y="300" bst:WIDTH="300" bst:HEIGHT="60">
              <FIGURE SUBTYPE="PapComment" FORMAT="1.00" ID="9" bst:UID="3f367f4f2bb84339b0197b1aadc6e3c2">
                <TEXT><![CDATA[Ausgabe: Text in „…“, danach
die Variable, deren Wert erscheint.]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="2" ROW="3" bst:X="364" bst:Y="150" bst:WIDTH="300" bst:HEIGHT="80">
              <FIGURE SUBTYPE="PapComment" FORMAT="1.00" ID="10" bst:UID="624bc86e14524bf6869d30578bc1f236">
                <TEXT><![CDATA[Ausprobieren: F9 öffnet den Schreibtischtest,
F5 lässt den Plan laufen. Mit F10 geht es
Schritt für Schritt, mit Strg+F10 zurück.]]></TEXT>
              </FIGURE>
            </ENTRY>
          </ENTRIES>
