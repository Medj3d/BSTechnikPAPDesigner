  <PROJECT FORMAT="1.00" NAME="Lernbeispiel 3 – Schleifen" AUTHOR="BS Technik" CREATED="2026.10.28 07:52:51" MODIFIED="2026.10.28 07:52:51" bst:DESCRIPTION="Summe 1 + 2 + … + n mit Fuß- und Kopfbedingung." bst:CREATED="2026-10-28T07:52:51+01:00" bst:MODIFIED="2026-10-28T07:52:51+01:00">
    <DIAGRAMS>
      <DIAGRAM FORMAT="1.00" ID="0" NAME="Lernbeispiel 3 – Schleifen" CREATED="2026.10.28 07:52:51" MODIFIED="2026.10.28 07:52:51">
        <LAYOUT FORMAT="1.00" COLUMNS="3" ROWS="13" bst:GRID_SIZE="20" bst:GRID_VISIBLE="True" bst:SNAP_TO_GRID="True" bst:ZOOM="1" bst:VIEW_X="0" bst:VIEW_Y="0">
          <ENTRIES>
            <ENTRY COLUMN="0" ROW="0" ANCHOR="True" bst:GENERATED="True">
              <FIGURE SUBTYPE="PapTitle" FORMAT="1.00" ID="0">
                <TEXT><![CDATA[Lernbeispiel 3 – Schleifen]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="1" ROW="1" bst:X="0" bst:Y="0" bst:WIDTH="120" bst:HEIGHT="40">
              <FIGURE SUBTYPE="PapStart" FORMAT="1.00" ID="1" bst:UID="0e1e0b856f7f4f4c87bb2d627570fbc1">
                <TEXT><![CDATA[Start]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="1" ROW="2" bst:X="0" bst:Y="100" bst:WIDTH="160" bst:HEIGHT="60">
              <FIGURE SUBTYPE="PapLoopStart" FORMAT="1.00" ID="2" ASSOCIATE="4" bst:UID="022869a6ffd645c9944d32af886bd576">
                <TEXT><![CDATA[wiederhole]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="1" ROW="3" bst:X="0" bst:Y="200" bst:WIDTH="160" bst:HEIGHT="60">
              <FIGURE SUBTYPE="PapInput" FORMAT="1.00" ID="3" bst:UID="d33e591823124d6a8fb9a2d7f2ad5fb2">
                <TEXT><![CDATA[Zahl n einlesen]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="1" ROW="4" bst:X="0" bst:Y="300" bst:WIDTH="160" bst:HEIGHT="60">
              <FIGURE SUBTYPE="PapLoopEnd" FORMAT="1.00" ID="4" ASSOCIATE="2" bst:UID="f4e8d671c2e640dd88d543011614ec4d">
                <TEXT><![CDATA[bis n > 0]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="1" ROW="5" bst:X="0" bst:Y="400" bst:WIDTH="160" bst:HEIGHT="60">
              <FIGURE SUBTYPE="PapActivity" FORMAT="1.00" ID="5" bst:UID="bb5a432447354d8785da1bbb88f4bafb">
                <TEXT><![CDATA[summe = 0
i = 1]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="1" ROW="6" bst:X="0" bst:Y="500" bst:WIDTH="160" bst:HEIGHT="60">
              <FIGURE SUBTYPE="PapLoopStart" FORMAT="1.00" ID="6" ASSOCIATE="9" bst:UID="fe274b3156494844aa0491f40ec70814">
                <TEXT><![CDATA[solange i <= n]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="1" ROW="7" bst:X="0" bst:Y="600" bst:WIDTH="160" bst:HEIGHT="60">
              <FIGURE SUBTYPE="PapActivity" FORMAT="1.00" ID="7" bst:UID="393e6d9053744f0fadfbee9abd287c78">
                <TEXT><![CDATA[summe = summe + i]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="1" ROW="8" bst:X="0" bst:Y="700" bst:WIDTH="160" bst:HEIGHT="60">
              <FIGURE SUBTYPE="PapActivity" FORMAT="1.00" ID="8" bst:UID="c014fd146508426890bed649d172028f">
                <TEXT><![CDATA[i = i + 1]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="1" ROW="10" bst:X="0" bst:Y="800" bst:WIDTH="160" bst:HEIGHT="60">
              <FIGURE SUBTYPE="PapLoopEnd" FORMAT="1.00" ID="9" ASSOCIATE="6" bst:UID="34e11b857c7749909881e85e8c494932">
                <TEXT><![CDATA[Schleifenende]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="1" ROW="11" bst:X="0" bst:Y="900" bst:WIDTH="160" bst:HEIGHT="60">
              <FIGURE SUBTYPE="PapOutput" FORMAT="1.00" ID="10" bst:UID="0848c7be85834ad7b98ed92c6751c617">
                <TEXT><![CDATA[„Summe:“ summe]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="1" ROW="12" bst:X="0" bst:Y="1000" bst:WIDTH="120" bst:HEIGHT="40">
              <FIGURE SUBTYPE="PapEnd" FORMAT="1.00" ID="11" bst:UID="ea05e0aff24847d6a11763170f405f38">
                <TEXT><![CDATA[Ende]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="0" ROW="3" bst:X="-390" bst:Y="200" bst:WIDTH="300" bst:HEIGHT="100">
              <FIGURE SUBTYPE="PapComment" FORMAT="1.00" ID="12" bst:UID="4f11e4d99dbd4221aaecdaaa66210709">
                <TEXT><![CDATA[Schleife mit Fußbedingung: Der Inhalt
läuft mindestens einmal; geprüft wird
am Ende („bis …“). Hier: so lange
fragen, bis n positiv ist.]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="0" ROW="7" bst:X="-390" bst:Y="600" bst:WIDTH="300" bst:HEIGHT="80">
              <FIGURE SUBTYPE="PapComment" FORMAT="1.00" ID="13" bst:UID="fe9591af7a19453baa20a1573df5403d">
                <TEXT><![CDATA[Schleife mit Kopfbedingung: geprüft
wird vorher („solange …“) – ist sie
falsch, läuft der Inhalt gar nicht.]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="2" ROW="5" bst:X="364" bst:Y="400" bst:WIDTH="300" bst:HEIGHT="80">
              <FIGURE SUBTYPE="PapComment" FORMAT="1.00" ID="14" bst:UID="2ddfe8ae86334c36be9e332e3c694567">
                <TEXT><![CDATA[Mehrere Zuweisungen in einem
Baustein: je Zeile eine
(Zeilenumbruch mit Strg+Enter).]]></TEXT>
              </FIGURE>
            </ENTRY>
            <ENTRY COLUMN="2" ROW="9" bst:X="364" bst:Y="750" bst:WIDTH="300" bst:HEIGHT="100">
              <FIGURE SUBTYPE="PapComment" FORMAT="1.00" ID="15" bst:UID="fefbf0ccaeba4fc2a41d3dc964f690f4">
                <TEXT><![CDATA[Einfügen → Schleife mit Kopf- bzw.
Fußbedingung legt beide Teile an.
Eine Schleife geht auch mit einer
Verzweigung und einem Pfeil zurück.]]></TEXT>
              </FIGURE>
            </ENTRY>
          </ENTRIES>
        </LAYOUT>
